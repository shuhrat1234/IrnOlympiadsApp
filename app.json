{
  "expo": {
    "name": "IRN Olympiads",
    "slug": "irn-olympiads",
    "scheme": "irnolympiads",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "backgroundColor": "#09090C",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "uz.irnolympiad.app",
      "buildNumber": "1",
      "appleTeamId": "XUBZC349A6",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Qo'llab-quvvatlash xizmatiga rasm yuborish uchun galereyaga ruxsat kerak.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "uz.irnolympiad.app",
      "versionCode": 2,
      "blockedPermissions": [
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#09090C",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "./plugins/withRemoveStoragePermissions",
      "expo-router",
      "expo-secure-store",
      "expo-sharing",
      "expo-image",
      "expo-font",
      "expo-web-browser",
      [
        "expo-image-picker",
        {
          "photosPermission": false,
          "cameraPermission": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 220,
          "backgroundColor": "#09090C",
          "resizeMode": "contain"
        }
      ],
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "b4cb3c43-489c-4397-8847-286423aa7089"
      }
    },
    "owner": "bsmoke2077"
  }
}
